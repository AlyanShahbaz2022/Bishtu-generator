# ─────────────────────────────────────────────────────────────
# Tech & Tune — environment variables
# Copy to `.env.local` and fill in. Never commit real secrets.
# Validated in src/lib/env.ts
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""
# Phase 9 — SEO & Analytics
NEXT_PUBLIC_GA_ID=""              # Google Analytics 4 measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GSC_VERIFICATION=""  # Google Search Console meta-tag token

# Phase 1 — Database (PostgreSQL)
# App runtime — Supabase transaction pooler (port 6543, ?pgbouncer=true).
DATABASE_URL=""
# Migrations / db push / seed — Supabase session pooler (port 5432, direct).
DIRECT_URL=""

# Phase 2 — Authentication (Better Auth)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage — Cloudinary (images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Unsigned browser uploads (admin drag & drop). Public by design.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Storage — UploadThing (brochures / datasheets / PDFs)
UPLOADTHING_TOKEN=""

# Email — Resend
RESEND_API_KEY=""
# Verified sender, e.g. "Tech & Tune <noreply@techandtune.pk>".
# Falls back to Resend's sandbox sender when unset.
EMAIL_FROM=""

# Phase 11 — Payments (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
