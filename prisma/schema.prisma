// Tech & Tune — Prisma schema
// Modeled from "project brief/DATABASE_SCHEMA.md" (cross-checked with TRD §5–6).
// Design principles: UUID primary keys, FK constraints, soft deletes where
// appropriate, timestamps on entities, indexed lookups, normalized model.
//
// NOTE (Phase 2): Better Auth owns User + Session / Account / Verification.
// `User` carries Better Auth's core fields (name, email, emailVerified, image,
// timestamps) plus our domain extras as Better Auth `additionalFields`
// (firstName, lastName, phone, role, …). Credentials live in `Account`
// (provider "credential"), not on `User`. See src/lib/auth.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Status {
  ACTIVE
  INACTIVE
}

enum FuelType {
  DIESEL
  PETROL
  GAS
}

enum GeneratorType {
  DIESEL
  PETROL
  SILENT
  OPEN_TYPE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  BANK_TRANSFER
  CASH
  JAZZCASH
  EASYPAISA
  STRIPE
  PAYPAL
}

enum PurchaseType {
  PURCHASE
  RENTAL
}

enum QuoteStatus {
  PENDING
  CONTACTED
  QUOTED
  APPROVED
  REJECTED
}

enum RentalStatus {
  PENDING
  REVIEWING
  QUOTED
  APPROVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ServicePriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum ServiceStatus {
  PENDING
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

// ─────────────────────── Authentication ──────────────────────

model User {
  // ── Better Auth core fields ──
  id            String  @id @default(uuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // ── Domain fields (exposed to Better Auth as additionalFields) ──
  firstName String?
  lastName  String?
  phone     String?
  // Denormalized role-name fast path for session/proxy checks
  // (mirrors Role.name slug). Normalized permissions live via roleId → Role.
  role      String     @default("customer")
  roleId    String?
  status    UserStatus @default(ACTIVE)
  lastLogin DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // ── Better Auth relations ──
  sessions Session[]
  accounts Account[]

  // ── Domain relations ──
  roleRef         Role?            @relation(fields: [roleId], references: [id])
  orders          Order[]
  addresses       Address[]
  wishlist        Wishlist[]
  reviews         Review[]
  cart            Cart?
  rentals         Rental[]
  serviceRequests ServiceRequest[]
  notifications   Notification[]
  blogs           Blog[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([roleId])
  @@index([role])
  @@index([status])
}

// ── Better Auth: session / account / verification ──

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id        String   @id @default(uuid())
  name      String
  module    String
  action    String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ───────────────────────── Catalog ───────────────────────────

model Category {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique
  description    String?
  image          String?
  parentId       String?
  seoTitle       String?
  seoDescription String?
  status         Status    @default(ACTIVE)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@index([status])
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logo        String?
  country     String?
  website     String?
  description String?
  status      Status    @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products Product[]

  @@index([slug])
  @@index([status])
}

model Product {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  sku              String         @unique
  categoryId       String
  brandId          String?
  price            Decimal        @db.Decimal(12, 2)
  salePrice        Decimal?       @db.Decimal(12, 2)
  costPrice        Decimal?       @db.Decimal(12, 2)
  stock            Int            @default(0)
  minimumStock     Int            @default(0)
  kva              Int?
  fuelType         FuelType?
  generatorType    GeneratorType?
  engineModel      String?
  alternator       String?
  voltage          String?
  frequency        String?
  phase            String?
  fuelTankCapacity String?
  fuelConsumption  String?
  runtime          String?
  weight           String?
  dimensions       String?
  noiseLevel       String?
  warranty         String?
  description      String?        @db.Text
  shortDescription String?
  featured         Boolean        @default(false)
  published        Boolean        @default(false)
  status           Status         @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  category       Category               @relation(fields: [categoryId], references: [id])
  brand          Brand?                 @relation(fields: [brandId], references: [id])
  images         ProductImage[]
  specifications ProductSpecification[]
  inventory      Inventory?
  reviews        Review[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  wishlist       Wishlist[]
  rentals        Rental[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([featured])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpecification {
  id        String @id @default(uuid())
  productId String
  title     String
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Inventory {
  id           String   @id @default(uuid())
  productId    String   @unique
  warehouse    String   @default("main")
  quantity     Int      @default(0)
  reserved     Int      @default(0)
  available    Int      @default(0)
  reorderLevel Int      @default(0)
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ──────────────────────── Shopping ───────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(12, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

// ───────────────────────── Orders ────────────────────────────

model Order {
  id                String           @id @default(uuid())
  userId            String?
  orderNumber       String           @unique
  status            OrderStatus      @default(PENDING)
  subtotal          Decimal          @db.Decimal(12, 2)
  discount          Decimal          @default(0) @db.Decimal(12, 2)
  shipping          Decimal          @default(0) @db.Decimal(12, 2)
  tax               Decimal          @default(0) @db.Decimal(12, 2)
  total             Decimal          @db.Decimal(12, 2)
  paymentStatus     PaymentStatus    @default(PENDING)
  paymentMethod     PaymentProvider?
  billingAddressId  String?
  shippingAddressId String?
  notes             String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User?       @relation(fields: [userId], references: [id])
  billingAddress  Address?    @relation("BillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress Address?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  items           OrderItem[]
  payment         Payment?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String          @id @default(uuid())
  orderId       String          @unique
  provider      PaymentProvider
  transactionId String?
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("PKR")
  status        PaymentStatus   @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  fullName   String
  phone      String
  country    String   @default("Pakistan")
  province   String?
  city       String
  postalCode String?
  address    String   @db.Text
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingOrders  Order[] @relation("BillingAddress")
  shippingOrders Order[] @relation("ShippingAddress")

  @@index([userId])
}

// ────────────────────── Lead-gen modules ─────────────────────

model Quote {
  id                   String         @id @default(uuid())
  name                 String
  company              String?
  email                String
  phone                String
  city                 String?
  generatorType        GeneratorType?
  requiredKVA          Int?
  brandPreference      String?
  purchaseType         PurchaseType   @default(PURCHASE)
  budget               String?
  installationRequired Boolean        @default(false)
  message              String?        @db.Text
  attachment           String?
  status               QuoteStatus    @default(PENDING)
  assignedTo           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model Rental {
  id                   String       @id @default(uuid())
  customerId           String?
  // Contact details for public (guest) requests; customerId links a user when
  // the requester is signed in.
  name                 String
  email                String
  phone                String
  productId            String?
  rentalStart          DateTime?
  rentalEnd            DateTime?
  location             String
  installationRequired Boolean      @default(false)
  transportRequired    Boolean      @default(false)
  expectedLoad         String?
  status               RentalStatus @default(PENDING)
  price                Decimal?     @db.Decimal(12, 2)
  notes                String?      @db.Text
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customer User?     @relation(fields: [customerId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])

  @@index([customerId])
  @@index([productId])
  @@index([status])
}

model ServiceRequest {
  id               String          @id @default(uuid())
  customerId       String?
  // Contact details for public (guest) requests.
  name             String
  email            String
  phone            String
  generatorBrand   String?
  generatorModel   String?
  serialNumber     String?
  problem          String          @db.Text
  priority         ServicePriority @default(MEDIUM)
  preferredDate    DateTime?
  address          String?
  attachments      String[]
  assignedEngineer String?
  status           ServiceStatus   @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customer User? @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([priority])
}

// ───────────────────── Content & community ───────────────────

model Review {
  id         String       @id @default(uuid())
  productId  String
  customerId String
  rating     Int
  title      String?
  review     String?      @db.Text
  images     String[]
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id])

  @@index([productId])
  @@index([customerId])
  @@index([status])
}

model Blog {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  excerpt        String?
  content        String    @db.Text
  coverImage     String?
  authorId       String?
  categoryId     String?
  published      Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  author   User?         @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([published])
  @@index([categoryId])
}

model BlogCategory {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  blogs Blog[]
}

model Project {
  id                String    @id @default(uuid())
  title             String
  slug              String    @unique
  client            String?
  location          String?
  generatorBrand    String?
  generatorCapacity String?
  completionDate    DateTime?
  description       String?   @db.Text
  images            String[]
  featured          Boolean   @default(false)
  published         Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([slug])
  @@index([published])
}

model Testimonial {
  id           String   @id @default(uuid())
  customerName String
  company      String?
  designation  String?
  rating       Int      @default(5)
  message      String   @db.Text
  photo        String?
  published    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  discountType DiscountType @default(PERCENTAGE)
  value        Decimal      @db.Decimal(12, 2)
  minimumOrder Decimal?     @db.Decimal(12, 2)
  startDate    DateTime?
  endDate      DateTime?
  usageLimit   Int?
  usageCount   Int          @default(0)
  status       CouponStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([code])
  @@index([status])
}

// ──────────────────────── System ─────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Media {
  id         String   @id @default(uuid())
  fileName   String
  url        String
  type       String?
  size       Int?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([type])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json?
  group     String?
  updatedAt DateTime @updatedAt

  @@index([group])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  module    String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}
